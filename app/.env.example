# CCAI（仮称）環境変数の一覧（SPEC-000a）。
# このファイルをコピーして .env.local を作り、値を入れる。.env* は git に入れない（.gitignore 済み）。
# 自動テスト（npm test）は .env なし・認証情報なしで全件通る。ここに実際のキーやパスワードを書かないこと。
# このファイルの値は空か、安全な既定値だけにする（tests/static-checks.test.ts が確かめる）。

# --- 認証基盤（Supabase）。3つとも未設定のときは、ログイン画面までは表示でき、登録・ログインは「接続先が設定されていません」になる ---
# プロジェクトのURL（例: https://xxxx.supabase.co）。サーバー側だけで使う（ブラウザには渡さない）
SUPABASE_URL=
# 公開用（anon）キー。サーバー側だけで使う。登録・ログインの呼び出しに使う
SUPABASE_ANON_KEY=
# 管理用（service_role）キー。**絶対にブラウザへ渡さない**。ログアウト時のセッション失効とアカウント削除に使う。src/server/privileged/ の中だけで読む
SUPABASE_SERVICE_ROLE_KEY=

# --- データベース ---
# Postgres への接続文字列（Supabase の「Connection string」。東京リージョンのプロジェクトのもの）。サーバー側だけで使う
DATABASE_URL=

# --- セッション ---
# セッションcookieの有効日数（既定 30。Q-P8 の目安）。認証基盤側の有効期間の上限設定は公開準備SPEC（有料プランが必要）
SESSION_COOKIE_MAX_AGE_DAYS=30

# --- テスト用（root で npm test を実行するときの、PostgreSQL を動かす一般ユーザーのID。通常は設定不要）---
CCAI_TEST_UID=
# 同上（グループID）
CCAI_TEST_GID=

# --- ビルド出力先（check-build.mjs が使う。通常は設定不要）---
NEXT_DIST_DIR=

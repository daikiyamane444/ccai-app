# CCAI（仮称）環境変数の一覧（SPEC-000a・000c）。
# このファイルをコピーして .env.local を作り、値を入れる。.env* は git に入れない（.gitignore 済み）。
# 本番（Vercel）では、同じ名前を Vercel の Environment Variables に入れる（手順は docs/runbooks/deploy-personal.md）。
# 自動テスト（npm test）は .env なし・認証情報なしで全件通る。ここに実際のキーやパスワードを書かないこと。
# このファイルの値は空か、安全な既定値だけにする（tests/static-checks.test.ts が確かめる）。
# 「NEXT_PUBLIC_」で始まる変数は作らない（ブラウザに渡る種類の変数。秘密を漏らす原因になる）。

# --- 認証基盤（Supabase）。未設定のときは、ログイン画面までは表示でき、登録・ログインは「接続先が設定されていません」になる ---
# プロジェクトのURL（例: https://xxxx.supabase.co）。サーバー側だけで使う（ブラウザには渡さない）。DBのプーラーのユーザー名に使うプロジェクトIDもここから取り出す
SUPABASE_URL=
# 公開用（anon）キー。サーバー側だけで使う。登録・ログインの呼び出しに使う
SUPABASE_ANON_KEY=
# 管理用（service_role）キー。**絶対にブラウザへ渡さない**。ログアウト時のセッション失効とアカウント削除に使う。src/server/privileged/ の中だけで読む
SUPABASE_SERVICE_ROLE_KEY=

# --- 新規登録の限定（SPEC-000c） ---
# 登録を許すメールアドレスの一覧（カンマ区切り。大文字小文字・前後の空白は無視）。空・未設定なら、登録は全部断られる（ログインは使える）。サーバー側だけ。リポジトリに書かない
SIGNUP_ALLOWED_EMAILS=

# --- データベース（アプリ用ロール ccai_app で接続する。SPEC-000c） ---
# 組み立て済みの接続文字列。自動テストと、ローカルでの手動接続用。次の DB_* と同時に設定した場合は、この DATABASE_URL が優先される
DATABASE_URL=
# 接続先ホスト。Supabase の「Connect」画面の Transaction pooler のホスト（例: aws-0-ap-northeast-1.pooler.supabase.com）をそのままコピーする
DB_HOST=
# 接続先ポート。空なら、プーラーは 6543（トランザクションモード）、それ以外は 5432
DB_PORT=
# データベース名。空なら postgres
DB_NAME=
# 接続ユーザー。空なら ccai_app（プーラーのときは ".<プロジェクトID>" を自動で付ける）
DB_USER=
# アプリ用ロール ccai_app のパスワード（supabase/manual/set-app-role-password.sql が作って画面に出す値）。秘密。サーバー側だけ
DB_PASSWORD=
# 暗号化の指定。空なら、ローカル以外のホストでは暗号化する。disable で無効、require で強制
DB_SSL=

# --- セッション ---
# セッションcookieの有効日数（既定 30。Q-P8 の目安）。認証基盤側の有効期間の上限設定は公開準備SPEC（有料プランが必要）
SESSION_COOKIE_MAX_AGE_DAYS=30

# --- 結合テスト用（GitHub Actions。手動起動。app/tests/integration/）。アプリ本体は読まない ---
# 公開URL（Vercel が発行した個人用URL。例: https://xxxx.vercel.app）。公開URLの確認（ヘッダー・cookie・配信物の検査）だけに使う
CI_SITE_URL=
# 公開URLの配信物に含まれてはいけない値として、検査に加える文字列（任意。登録許可の一覧のうち1つ）。空なら、この検査は省く
CI_LEAK_PROBE=
# 期限切れトークンの確認（long ジョブ）で待つ秒数。空なら 3900（65分。アクセストークンの有効期間の既定1時間より長く）
CI_TOKEN_WAIT_SECONDS=
# テスト用ユーザーのパスワード（scripts/run-integration.mjs が実行ごとにランダムに作って渡す。設定不要）
CI_TEST_PASSWORD=
# 結合テストの実行ID（GitHub Actions が入れる。ローカルでは未設定でよい）
CI_RUN_ID=

# --- テスト用（root で npm test を実行するときの、PostgreSQL を動かす一般ユーザーのID。通常は設定不要）---
CCAI_TEST_UID=
# 同上（グループID）
CCAI_TEST_GID=

# --- ビルド出力先（check-build.mjs が使う。通常は設定不要）---
NEXT_DIST_DIR=
